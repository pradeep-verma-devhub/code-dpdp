{
  "name": "code-dpdp",
  "version": "1.0.0",
  "type": "module",
  "description": "Automated CLI Compliance & Security Scanner for India's Digital Personal Data Protection Act 2023 & DPDP Rules 2025",
  "main": "bin/code-dpdp",
  "bin": {
    "code-dpdp": "./bin/code-dpdp",
    "dpdp-audit": "./bin/dpdp-audit.js"
  },
  "scripts": {
    "start": "./bin/code-dpdp",
    "scan": "./bin/code-dpdp scan",
    "pii": "./bin/code-dpdp pii",
    "consent": "./bin/code-dpdp consent",
    "egress": "./bin/code-dpdp egress",
    "live": "./bin/code-dpdp live",
    "rules": "./bin/code-dpdp rules",
    "list-rules": "./bin/code-dpdp list-rules",
    "penalty": "./bin/code-dpdp penalty",
    "patch": "./bin/code-dpdp patch",
    "coderabbit": "./bin/code-dpdp coderabbit",
    "info": "./bin/code-dpdp info",
    "cli": "./bin/code-dpdp",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": ".venv/bin/pytest python/tests"
  },
  "keywords": [
    "dpdp",
    "code-dpdp",
    "dpdp-act-2023",
    "compliance",
    "cli",
    "privacy",
    "security-scanner",
    "pii",
    "ast",
    "india-privacy"
  ],
  "author": "DPDP Compliance Engineering Team",
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
